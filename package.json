{
    "name": "dafkedd_cli",
    "version": "0.54.11",
    "description": "Interactive CLI that scaffolds a project (Next.js frontend, NestJS backend, Pasport login server or linked app, docs) locally, never globally",
    "type": "module",
    "bin": {
        "DafkeDD_CLI": "bin/cli.js"
    },
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "start": "node bin/cli.js",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "node scripts/run-tests.mjs",
        "postinstall": "node scripts/setup-hooks.mjs",
        "verify": "node scripts/verify-apps.mjs",
        "labels": "node scripts/setup-labels.mjs"
    },
    "dependencies": {
        "@inquirer/prompts": "^8.7.3",
        "cli-progress": "^3.12.0",
        "marked": "^18.1.0",
        "pg": "^8.23.1",
        "picocolors": "^1.1.1"
    },
    "devDependencies": {
        "prettier": "^3.9.10",
        "prettier-plugin-tailwindcss": "^0.8.1"
    }
}
