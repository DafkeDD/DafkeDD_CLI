{
    "name": "dafkedd_cli",
    "version": "0.48.0",
    "description": "Interactieve CLI om per project een frontend te installeren (nooit globaal)",
    "type": "module",
    "bin": {
        "DafkeDD_CLI": "bin/cli.js"
    },
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "start": "node bin/cli.js",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "node scripts/run-tests.mjs",
        "postinstall": "node scripts/setup-hooks.mjs",
        "verify": "node scripts/verify-apps.mjs",
        "labels": "node scripts/setup-labels.mjs"
    },
    "dependencies": {
        "@inquirer/prompts": "^8.7.3",
        "cli-progress": "^3.12.0",
        "marked": "^18.1.0",
        "picocolors": "^1.1.1"
    },
    "devDependencies": {
        "prettier": "^3.9.10",
        "prettier-plugin-tailwindcss": "^0.8.1"
    }
}
